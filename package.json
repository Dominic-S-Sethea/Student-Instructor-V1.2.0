{
  "name": "cdes-student-instructor",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server/server.cjs && esbuild server/db/runRetentionCli.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server/retention.cjs && node scripts/copy-db-assets.mjs",
    "start": "node dist/server/server.cjs",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "node scripts/run-tests.mjs",
    "test:coverage": "node scripts/run-coverage.mjs",
    "test:stress": "tsx scripts/stress-test.ts",
    "test:e2e:browser": "python3 scripts/e2e-browser-smoke.py",
    "verify:catalog": "tsx scripts/verify-catalog-integrity.ts",
    "audit:dep": "npm audit --omit=dev",
    "retention:run": "node dist/server/retention.cjs",
    "retention:cron": "node server/db/retention_cron.js"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/bcryptjs": "^3.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "esbuild": "^0.25.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
