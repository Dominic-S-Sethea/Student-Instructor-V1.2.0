{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "esModuleInterop": true,
    "allowJs": false,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["server", "shared", "server/tests", "server/db", "server/services", "server/repositories", "server/controllers"],
  "exclude": ["node_modules", "dist", "server/data"]
}
