{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "esModuleInterop": true,
    "allowJs": false,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["server.ts", "server", "shared", "scripts/*.ts"],
  "exclude": ["node_modules", "dist"]
}
