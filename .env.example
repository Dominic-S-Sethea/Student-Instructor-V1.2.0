# ==============================================================================
# CDES Student-Instructor Platform — Environment Configuration Template
# Copy to .env for local development. NEVER commit .env or real secrets to Git.
# ==============================================================================

# --- Core Server & Runtime ---
NODE_ENV="development"
HOST="127.0.0.1"
PORT="3000"
LOG_LEVEL="info"

# --- Database (Native node:sqlite, WAL mode) ---
# Production/container deployments should point this to a persistent volume.
DATABASE_PATH="./server/data/cdes_platform.db"
SLOW_QUERY_THRESHOLD_MS="200"

# --- Authentication & Security ---
# REQUIRED in production/staging: minimum 32 cryptographically random characters.
# Example generator: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-strong-random-secret-at-least-32-chars"
JWT_EXPIRES_IN="7d"
# Dedicated salt for anonymized education research cohort pseudonymization.
RESEARCH_SALT="replace-with-a-strong-random-research-salt"

# --- Reverse Proxy, CORS & Cookies ---
# Comma-separated list of allowed browser origins (no wildcard when credentials are enabled).
FRONTEND_ORIGIN="http://localhost:3000"
# Set to 1 when deployed behind a single reverse proxy (Nginx / Cloudflare / Cloud Run).
TRUST_PROXY="0"
# Set to "true" over HTTPS in production; "false" only for plain HTTP localhost testing.
COOKIE_SECURE="false"

# --- Optional AI Provider (Gemini) ---
# Leave empty to run cleanly in deterministic local-fallback mode (aiEnabled: false).
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
